# Copy to .env (which is not committed). Values with $ or spaces need single quotes.

# Your domain. It must point at this machine, with ports 80 and 443 open, for a real certificate.
# Leave it as localhost to try things out (the browser will warn about the private certificate).
TONETOOL_DOMAIN=localhost

# The one user. Build the image once (docker build -t tonetool .), then make the hash with:
#   docker run --rm -it tonetool tonetool hash-password
TONETOOL_USERNAME=choir
TONETOOL_PASSWORD_HASH=

# Signs the session cookies, so keep it private and long. Make one with:
#   docker run --rm tonetool tonetool make-secret
TONETOOL_SECRET=

# Only to try it on other ports:
# TONETOOL_HTTP_PORT=8080
# TONETOOL_HTTPS_PORT=8443
